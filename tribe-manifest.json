{
  "serviceId": "sho-team",
  "name": "SHO Team Backend",
  "serviceType": "tribe",
  "baseUrl": "http://localhost:3001",
  "requiredScopes": ["tribe:sho-team:read", "tribe:sho-team:write"],
  "exposes": ["/api/v1/health", "/api/v1/location/resolve"],
  "consumes": ["payment", "email"],
  "healthCheck": "/api/v1/health",
  "version": "1.0.0",
  "description": "SHO Team Backend service built as a NestJS monorepo microservices backend"
}
